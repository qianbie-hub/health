# Backend Local & Production Environment Variables
ENVIRONMENT=development
DEBUG=true

# Database (Leave blank to use local vigil.db SQLite, or specify PostgreSQL)
DATABASE_URL=sqlite:///./vigil.db

# JWT Secret Key
SECRET_KEY=vigil-local-development-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SMTP Email Dispatch (Leave empty to use terminal simulator in dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Vigil Health Security <no-reply@vigilhealth.ai>
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# Optional External AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
